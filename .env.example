# Supergence Environment Configuration
# Works with any OpenAI-compatible provider: OpenRouter, OpenAI, Local Ollama, Groq, etc.

# 1. Primary Model Provider
API_KEY=your-api-key-here
BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=openai/gpt-4o-mini
FALLBACK_MODEL=anthropic/claude-3.5-sonnet

# 2. Local Ollama Alternative (Uncomment to use local offline models)
# API_KEY=ollama
# BASE_URL=http://127.0.0.1:11434/v1
# DEFAULT_MODEL=llama3.2

# 3. Server Port (Default: 3001)
PORT=3001

# 4. Background Loops
ENABLE_BACKGROUND_LLM_LOOPS=false
# AREM reviews saved conversations while idle. Set false to disable automatic review.
ENABLE_AREM_SLEEP=true
