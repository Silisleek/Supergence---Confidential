{
  "name": "sis-1.0",
  "version": "1.0.0",
  "description": "Superintelligence System — Brain-like AI orchestration",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node server/index.js",
    "client": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "test:integration": "node tests/verify-claude-sis-integration.mjs",
    "icons": "node scripts/generate-icons.js",
    "desktop:dev": "electron .",
    "desktop:portable": "electron-builder --win portable --x64",
    "desktop:build": "electron-builder --win nsis --x64",
    "desktop:dist": "electron-builder --win --x64",
    "lint": "eslint client server electron scripts/maintenance scripts/build.mjs scripts/dev.mjs tests/unit tests/browser vite.config.js eslint.config.js --max-warnings 0",
    "format": "prettier --write client server electron scripts tests docs wiki demos *.md *.json *.js --ignore-unknown",
    "format:check": "prettier --check client server electron scripts tests docs wiki demos *.md *.json *.js --ignore-unknown",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:browser": "node --import ./tests/browser/session-setup.mjs tests/browser/workspace-smoke.mjs",
    "test:preview": "node tests/browser/project-preview-security.mjs && node --import ./tests/browser/session-setup.mjs tests/browser/project-preview-app.mjs && node --import ./tests/browser/session-setup.mjs tests/browser/preview-error.mjs",
    "test:artifact-security": "node --import ./tests/browser/session-setup.mjs tests/browser/artifacts-security.mjs",
    "test:screenshot": "node tests/browser/screenshot-live.mjs",
    "test:figcraft": "node tests/browser/figcraft-live.mjs",
    "check": "npm run lint && npm run format:check && npm run test:unit && npm run build",
    "test:ui": "node --import ./tests/browser/session-setup.mjs tests/browser/workspace-ui.mjs",
    "test:artifacts": "node --import ./tests/browser/session-setup.mjs tests/browser/chat-artifacts.mjs",
    "test:result-summary": "node --import ./tests/browser/session-setup.mjs tests/browser/result-summary.mjs",
    "test:learning-ui": "node --import ./tests/browser/session-setup.mjs tests/browser/learning-workspace.mjs",
    "test:knowledge-ui": "node --import ./tests/browser/session-setup.mjs tests/browser/knowledge-library.mjs && node --import ./tests/browser/session-setup.mjs tests/browser/knowledge-context.mjs",
    "test:evolution-ui": "node --import ./tests/browser/session-setup.mjs tests/browser/evolution-studio.mjs",
    "test:memory-ui": "node --import ./tests/browser/session-setup.mjs tests/browser/conversation-memory.mjs",
    "test:workspace-browser": "node --import ./tests/browser/session-setup.mjs tests/browser/workspace-browser.mjs",
    "test:login": "node --import ./tests/browser/session-setup.mjs tests/browser/workspace-login.mjs",
    "test:runtime": "node --import ./tests/browser/session-setup.mjs tests/browser/workspace-runtime.mjs",
    "test:collaboration": "node --import ./tests/browser/session-setup.mjs tests/browser/workspace-collaboration.mjs",
    "test:quality": "node scripts/benchmarks/creative-quality.mjs"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "archiver": "^7.0.1",
    "cheerio": "^1.0.0",
    "chokidar": "^4.0.0",
    "concurrently": "^9.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "esbuild": "0.25.12",
    "express": "^4.21.0",
    "fflate": "0.8.3",
    "node-fetch": "^3.3.2",
    "openai": "^4.67.0",
    "pdfjs-dist": "6.4.299",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "three": "^0.186.0",
    "uuid": "^14.0.3",
    "ws": "^8.18.0"
  },
  "overrides": {
    "qs": "^6.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^42.11.18",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "vite": "^7.3.7"
  },
  "build": {
    "appId": "com.supergence.sis",
    "productName": "Supergence",
    "copyright": "Copyright © 2026 Supergence",
    "directories": {
      "output": "release"
    },
    "files": [
      "client/**/*",
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "scripts/anti-slop.js",
      "resources/**/*",
      "package.json",
      "demos/**/*"
    ],
    "extraResources": [
      "resources/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*",
      "**/node_modules/esbuild/**/*",
      "**/node_modules/@esbuild/**/*"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Supergence SIS 1.0",
      "uninstallDisplayName": "Supergence SIS 1.0",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "author": "Supergence Team"
}
